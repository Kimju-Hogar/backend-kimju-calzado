
# ==========================================================================
# PAGOS A CUOTAS  (Addi / Sistecredito)
# ==========================================================================
# Nombre con el que esta tienda aparece como CANAL en el Panel de Contabilidad.
STORE_NAME=Kimju Calzado

# URL publica de este backend. La usan Addi y Sistecredito para notificarnos.
# Debe ser accesible desde internet (no localhost) para que lleguen los webhooks.
API_URL=https://api-calzado.kimjuhogar.com

# Logo que se muestra dentro del flujo del financiador (opcional).
STORE_LOGO_URL=

# --- Addi -----------------------------------------------------------------
# Poner en true SOLO cuando ya esten las credenciales reales del comercio.
# Con esto en false, el boton de Addi no aparece en el checkout.
ADDI_ENABLED=false
ADDI_CLIENT_ID=
ADDI_CLIENT_SECRET=

# Produccion:
#   ADDI_AUTH_URL=https://auth.addi.com/oauth/token
#   ADDI_AUDIENCE=https://api.addi.com
#   ADDI_API_URL=https://api.addi.com
# Pruebas (staging), que es donde hay que empezar:
#   ADDI_AUTH_URL=https://auth.addi-staging.com/oauth/token
#   ADDI_AUDIENCE=https://api.addi-staging.com
#   ADDI_API_URL=https://api.addi-staging.com
ADDI_AUTH_URL=https://auth.addi-staging.com/oauth/token
ADDI_AUDIENCE=https://api.addi-staging.com
ADDI_API_URL=https://api.addi-staging.com

# Identificador del comercio que entrega Addi (si aplica al contrato).
ADDI_ALLY_SLUG=

# Rango de compra en el que se ofrece Addi (pesos colombianos).
ADDI_MIN_AMOUNT=150000
ADDI_MAX_AMOUNT=6000000

# Secreto opcional para validar los webhooks entrantes de Addi.
ADDI_WEBHOOK_SECRET=

# --- Sistecredito ---------------------------------------------------------
SISTECREDITO_ENABLED=false
SISTECREDITO_API_URL=
SISTECREDITO_MERCHANT_ID=
SISTECREDITO_API_KEY=
SISTECREDITO_CLIENT_ID=
SISTECREDITO_CLIENT_SECRET=

# Rutas del API. Sistecredito entrega un contrato distinto segun el paquete
# contratado; si las suyas difieren, se cambian aqui y nada mas.
SISTECREDITO_TOKEN_PATH=/api/v1/auth/token
SISTECREDITO_CREATE_PATH=/api/v1/payments
SISTECREDITO_STATUS_PATH=/api/v1/payments/{id}

SISTECREDITO_MIN_AMOUNT=100000
SISTECREDITO_MAX_AMOUNT=8000000
SISTECREDITO_WEBHOOK_SECRET=

# --- Simulador de pruebas -------------------------------------------------
# Permite recorrer el flujo completo en local sin credenciales. Abre una
# pantalla donde hay que aprobar o rechazar a mano: nunca aprueba solo, y las
# ordenes que confirma NO se envian al Panel de Contabilidad.
# Queda desactivado por completo cuando NODE_ENV=production.
PAYMENTS_SIMULATOR=false
